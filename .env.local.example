# =============================================================================
# SPhoto Local Development Environment
# =============================================================================
# Copy this file to .env.local and fill in values.
# API keys persist across restarts - get them once from Immich UI.
# =============================================================================

# -----------------------------------------------------------------------------
# Immich Version
# -----------------------------------------------------------------------------
IMMICH_VERSION=release

# -----------------------------------------------------------------------------
# Database Passwords (can leave as defaults for local dev)
# -----------------------------------------------------------------------------
DB_PASSWORD_FREE=localdev
DB_PASSWORD_PAID=localdev

# -----------------------------------------------------------------------------
# Deployment Mode (always 'shared' for local dev)
# -----------------------------------------------------------------------------
DEPLOYMENT_MODE=shared

# -----------------------------------------------------------------------------
# Domain (not used in ports model, but needed by some code paths)
# -----------------------------------------------------------------------------
DOMAIN=localhost

# -----------------------------------------------------------------------------
# Shared Instance URLs (automation connects to Immich via these)
# For local dev, use localhost ports since automation runs on host
# -----------------------------------------------------------------------------
SHARED_FREE_INTERNAL_URL=http://localhost:2283
SHARED_PAID_INTERNAL_URL=http://localhost:2284

# -----------------------------------------------------------------------------
# Shared Instance API Keys (PERSISTENT - get once, save forever)
# -----------------------------------------------------------------------------
# After first startup:
# 1. Go to http://localhost:2283, complete setup, create admin user
# 2. Go to Account Settings > API Keys > Create new key
# 3. Paste the key below
# 4. Repeat for http://localhost:2284
#
# These keys survive container restarts! Only regenerate if you wipe the DB.
# -----------------------------------------------------------------------------
SHARED_FREE_API_KEY=
SHARED_PAID_API_KEY=

# -----------------------------------------------------------------------------
# Local Instances Directory (for shared user metadata)
# -----------------------------------------------------------------------------
INSTANCES_DIR=./.local/instances

# -----------------------------------------------------------------------------
# Web App Environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DOMAIN=localhost
NEXT_PUBLIC_DEPLOYMENT_MODE=shared

# -----------------------------------------------------------------------------
# Automation Server Port
# -----------------------------------------------------------------------------
PORT=3001

# -----------------------------------------------------------------------------
# Admin API Key (for admin endpoints - can be any random string locally)
# -----------------------------------------------------------------------------
ADMIN_API_KEY=local-dev-key

# -----------------------------------------------------------------------------
# Stripe (optional - use test mode keys for local development)
# -----------------------------------------------------------------------------
# To test paid subscriptions locally:
# 1. Go to https://dashboard.stripe.com/test/apikeys
# 2. Copy the "Secret key" (starts with sk_test_)
# 3. Create test products/prices at https://dashboard.stripe.com/test/products
# 4. Copy the price IDs (start with price_)
# 5. For webhooks, use Stripe CLI: stripe listen --forward-to localhost:3001/webhook
#    Copy the webhook signing secret (starts with whsec_)
# 6. Test card number: 4242 4242 4242 4242 (any future expiry, any CVC)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# -----------------------------------------------------------------------------
# Resend Email (optional - leave empty for local dev without emails)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=SPhoto <noreply@localhost>

# -----------------------------------------------------------------------------
# Admin credentials for stats dashboard (optional)
# -----------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=admin@localhost
