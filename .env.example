# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
# Never commit .env.

# Public address of the SPhoto web app and of the two Immich instances (used in links and mails).
PUBLIC_URL=https://sphoto.example.com
FREE_IMMICH_URL=https://free.sphoto.example.com
PAID_IMMICH_URL=https://photos.sphoto.example.com

# Host ports. Put a TLS reverse proxy in front, or use compose.proxy.yaml (see docs/DEPLOYMENT.md).
APP_PORT=3000
FREE_PORT=2283
PAID_PORT=2284

# Admin access to the SPhoto admin pages (Bearer key). At least 24 characters.
ADMIN_API_KEY=change-me-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com

# Immich. IMMICH_ADMIN_EMAIL becomes the admin account on both instances at first start;
# SPhoto then creates its own scoped API key and keeps the passwords only here.
IMMICH_VERSION=v3.3.3
IMMICH_ADMIN_EMAIL=photos-admin@example.com
FREE_IMMICH_ADMIN_PASSWORD=change-me-at-least-12-chars
PAID_IMMICH_ADMIN_PASSWORD=change-me-at-least-12-chars
DB_PASSWORD=change-me-postgres

# Enable machine learning (face and object search) for the paid instance: COMPOSE_PROFILES=ml
COMPOSE_PROFILES=ml

# Mail: "resend" (RESEND_API_KEY) or "smtp" (SMTP_URL=smtp://user:pass@host:587)
MAIL_PROVIDER=resend
MAIL_FROM=SPhoto <noreply@example.com>
RESEND_API_KEY=re_xxx
SMTP_URL=

# Stripe: webhook endpoint is PUBLIC_URL/api/stripe/webhook with the events
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Plans (defaults shown)
FREE_QUOTA_GB=5
BASIC_QUOTA_GB=200
PRO_QUOTA_GB=1000
BASIC_PRICE_CHF=5
PRO_PRICE_CHF=15

# Grace periods and export rules (days)
DELETION_GRACE_DAYS=14
CANCELLATION_GRACE_DAYS=14
EXPORT_TTL_DAYS=7
EXPORT_COOLDOWN_DAYS=30
