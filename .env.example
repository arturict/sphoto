# Configure before starting. These are placeholders, not usable production credentials.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PASSWORD=replace-with-a-unique-database-password
PUBLIC_URL=http://localhost:19000
APP_PORT=19000
IMMICH_PORT=19283
BIND_ADDRESS=127.0.0.1
# manual: operator grants plans; no money is collected.
# stripe: requires all four Stripe settings. Use TEST mode for verification.
BILLING_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
