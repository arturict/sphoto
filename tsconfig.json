{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": ".", "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "playwright.config.ts"]
}
